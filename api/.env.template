


PORT = 3000

PUBLIC_PATH = public

POSTGRES_URL = postgresql://usuario:password@localhost:5432/basededatos

JWT_SEED = randomSeedForJWT

# URL del frontend — se usa para armar el link de verificación de correo
# (http://localhost:5173/verificar-correo/<token>). En producción, la URL pública real.
APP_BASE_URL = http://localhost:5173

# SMTP para el envío del correo de verificación de cuenta.
# Si se dejan vacías, el sistema NO falla: el link de verificación se imprime
# en la consola del backend (modo desarrollo), útil para probar sin credenciales reales.
# Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu correo,
# SMTP_PASS=una "contraseña de aplicación" (no la contraseña normal de la cuenta).
SMTP_HOST =
SMTP_PORT = 587
SMTP_USER =
SMTP_PASS =
SMTP_FROM = Ambienta ERP <no-reply@ambienta.local>