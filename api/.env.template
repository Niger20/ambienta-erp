


PORT = 3000

PUBLIC_PATH = public

POSTGRES_URL = postgresql://usuario:password@localhost:5432/basededatos

JWT_SEED = randomSeedForJWT

# URL del frontend — se usa para armar el link de verificación de correo
# (http://localhost:5173/verificar-correo/<token>). En producción, la URL pública real.
APP_BASE_URL = http://localhost:5173

# Envío del correo de verificación de cuenta. Prioridad: Resend > SMTP > consola.
#
# Resend (recomendado, sobre todo en producción/Railway — es HTTP, no bloqueable
# como el puerto SMTP). Crea una cuenta gratis en resend.com y una API key.
RESEND_API_KEY =
RESEND_FROM = Ambienta ERP <onboarding@resend.dev>
#
# SMTP (alternativa; falla en hostings que bloquean el puerto saliente, como
# Railway). Si se dejan vacías junto con RESEND_API_KEY, el sistema NO falla:
# el link de verificación se imprime en la consola del backend (modo desarrollo).
# Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu correo,
# SMTP_PASS=una "contraseña de aplicación" (no la contraseña normal de la cuenta).
SMTP_HOST =
SMTP_PORT = 587
SMTP_USER =
SMTP_PASS =
SMTP_FROM = Ambienta ERP <no-reply@ambienta.local>

# Orígenes adicionales permitidos por CORS (localhost siempre está permitido y
# no hace falta listarlo aquí). Separados por coma si hay más de uno.
# En producción (Railway, etc.) se configura esta misma variable en el
# dashboard del servicio, con la URL pública real — nunca hardcodeada en el código.
ALLOWED_ORIGINS = https://tu-dominio-de-produccion.up.railway.app